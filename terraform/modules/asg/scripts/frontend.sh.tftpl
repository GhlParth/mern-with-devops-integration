#!/bin/bash
set -e

# ── Ensure the AWS CLI is in the PATH ──
export PATH=$PATH:/usr/local/bin


# ── Helper function for retries ──
retry() {
  local n=1; local max=10; local delay=5
  while true; do
    "$@" && break || {
      if [[ $n -lt $max ]]; then
        ((n++)); echo "Command failed. Attempt $n/$max. Retrying in $delay..."; sleep $delay;
      else
        echo "Failed after $n attempts."; return 1
      fi
    }
  done
}

# ── Log all output for debugging ──
exec > >(tee /var/log/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1
echo "Starting resilient Frontend boot script..."

# ── Install Docker ──────────────────────────
retry apt-get update -y
retry apt-get install -y ca-certificates curl gnupg lsb-release unzip

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

retry apt-get update -y
retry apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl start docker
systemctl enable docker

# ── Install AWS CLI ───────────────────────────────────────
retry curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp/awscli
retry /tmp/awscli/aws/install
rm -rf /tmp/awscliv2.zip /tmp/awscli

# ── Fetch secrets ───────────────────
REGION="${aws_region}"
echo "Fetching GITHUB_TOKEN from SSM in $REGION..."
GITHUB_TOKEN=$(retry /usr/local/bin/aws ssm get-parameter --name "/taskflow/github_token" --with-decryption --region $REGION --query "Parameter.Value" --output text)

# ── Validate Token ──────────────────
if [ -z "$GITHUB_TOKEN" ] || [ "$GITHUB_TOKEN" == "None" ]; then
  echo "CRITICAL ERROR: GITHUB_TOKEN is empty or could not be fetched. Check IAM permissions and SSM Parameter path."
  exit 1
fi
echo "GITHUB_TOKEN successfully fetched."

# ── Pull and run frontend ──────────────────────────
retry sh -c "echo '$GITHUB_TOKEN' | /usr/bin/docker login ghcr.io -u ghlparth --password-stdin"
retry /usr/bin/docker pull ghcr.io/ghlparth/taskflow-frontend:latest

docker run -d \
  --name taskflow-frontend \
  --user root \
  --restart always \
  -p 80:80 \
  ghcr.io/ghlparth/taskflow-frontend:latest

docker image prune -f
echo "Frontend boot successfully completed at $(date)"
